# Copy to .env and export these before starting the server (or set them in your shell).

# Required in real use: a long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# SQLite works with no setup. For MySQL:
# DATABASE_URL=mysql+pymysql://orbit:your_password@localhost:3306/orbit?charset=utf8mb4
DATABASE_URL=sqlite:///./orbit.db

# Set to 1 when the site is served over HTTPS so the login cookie is HTTPS-only.
COOKIE_SECURE=0
